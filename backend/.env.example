# Copy this file to backend/.env for local configuration. Never commit backend/.env.
# Local development is intentionally usable without a bearer token.
APP_ENV=development

# GROQ_API_KEY=replace-with-your-provider-key

# Production is fail-closed: APP_ENV=production requires this server-side token
# for /api/* and /mcp. Send it only from a trusted server or an authenticated
# proxy; never put it in VITE_* or any browser bundle.
# DEADLINE_RESCUE_API_TOKEN=generate-a-long-random-value
# DEADLINE_RESCUE_MCP_TOKEN=optional-separate-token-for-mcp-clients

# Exact browser origins only (comma-separated, no wildcard). Set both when the
# frontend and backend use different public origins.
# CORS_ALLOWED_ORIGINS=https://app.example.com
# MCP_ALLOWED_ORIGINS=https://app.example.com

# Per-process limits. Use a gateway/WAF limiter too when running multiple workers.
# API_RATE_LIMIT_PER_MINUTE=120
# ASSISTANT_RATE_LIMIT_PER_MINUTE=30
# MCP_RATE_LIMIT_PER_MINUTE=60
# MAX_REQUEST_BODY_BYTES=65536
