# Copy this to deploy/.env and replace every value. Never commit deploy/.env.
# PUBLIC_HOSTNAME must be a DNS name that points at the host; Caddy obtains TLS.
PUBLIC_HOSTNAME=preview.example.com
PUBLIC_ORIGIN=https://preview.example.com
CADDY_EMAIL=owner@example.com

# Generate a long random API value and hold it only in server/deployment secrets.
DEADLINE_RESCUE_API_TOKEN=REPLACE_WITH_A_LONG_RANDOM_TOKEN

# The preview login is separate from the backend token. Generate the hash with:
# docker run --rm caddy:2.10-alpine caddy hash-password --plaintext 'choose-a-long-password'
DEADLINE_RESCUE_DEMO_USER=REPLACE_WITH_DEMO_USERNAME
DEADLINE_RESCUE_DEMO_PASSWORD_HASH=REPLACE_WITH_CADDY_PASSWORD_HASH
